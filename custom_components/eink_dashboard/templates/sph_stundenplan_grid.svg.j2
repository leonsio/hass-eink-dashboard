{% set row_h = 72 %}<svg xmlns="http://www.w3.org/2000/svg" width="{{ w }}" height="{{ h }}">
<rect width="100%" height="100%" fill="#ffffff"/>
{% if not has_entity %}<text x="12" y="30" font-family="Roboto" font-size="22" fill="#000000">{{ empty_text }}</text>{% else %}
{% set first_col = 72 %}{% set col_w = (w - first_col) / (days|length if days|length else 1) %}<rect x="0" y="0" width="{{ w }}" height="48" fill="#eeeeee"/><text x="36" y="31" text-anchor="middle" font-family="Roboto" font-size="16" font-weight="700" fill="#000000">Std.</text>
{% for day in days %}{% set x0 = first_col + loop.index0 * col_w %}<rect x="{{ x0 }}" y="0" width="{{ col_w }}" height="48" fill="#eeeeee" stroke="#cccccc" stroke-width="1"/><text x="{{ x0 + col_w / 2 }}" y="22" text-anchor="middle" font-family="Roboto" font-size="18" font-weight="700" fill="#000000">{{ day.name }}</text><text x="{{ x0 + col_w / 2 }}" y="39" text-anchor="middle" font-family="Roboto" font-size="13" fill="#666666">{{ day.date }}</text>{% endfor %}
{% for row in grid_rows %}{% set y0 = 48 + loop.index0 * row_h %}<rect x="0" y="{{ y0 }}" width="{{ w }}" height="{{ row_h }}" fill="#ffffff" stroke="#cccccc" stroke-width="1"/><text x="36" y="{{ y0 + 29 }}" text-anchor="middle" font-family="Roboto" font-size="18" font-weight="700" fill="#000000">{{ row.period }}.</text>{% for lessons in row.cells %}{% set x0 = first_col + loop.index0 * col_w %}<rect x="{{ x0 }}" y="{{ y0 }}" width="{{ col_w }}" height="{{ row_h }}" fill="#ffffff" stroke="#cccccc" stroke-width="1"/>{% for lesson in lessons %}<text x="{{ x0 + col_w / 2 }}" y="{{ y0 + 23 }}" text-anchor="middle" font-family="Roboto" font-size="18" font-weight="700" fill="#000000">{{ lesson.subject }}</text><text x="{{ x0 + col_w / 2 }}" y="{{ y0 + 43 }}" text-anchor="middle" font-family="Roboto" font-size="13" fill="#666666">{{ lesson.teacher }}{% if lesson.room %} · {{ lesson.room }}{% endif %}</text>{% if lesson.badge %}<text x="{{ x0 + col_w / 2 }}" y="{{ y0 + 61 }}" text-anchor="middle" font-family="Roboto" font-size="12" font-weight="700" fill="#000000">{{ lesson.badge }}</text>{% endif %}{% if lesson.cancelled %}<line x1="{{ x0 + 8 }}" y1="{{ y0 + 25 }}" x2="{{ x0 + col_w - 8 }}" y2="{{ y0 + 25 }}" stroke="#000000" stroke-width="2"/>{% endif %}{% endfor %}{% endfor %}{% endfor %}{% endif %}
</svg>
