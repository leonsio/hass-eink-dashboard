<svg xmlns="http://www.w3.org/2000/svg" width="{{ w }}" height="{{ h if h > 0 else [120, days|length * 180]|max }}">
{% set row_h = 52 %}{% set header_h = 42 %}{% set day_h = header_h + (days|map(attribute='lessons')|map('length')|max(default=0) * row_h) %}{% set total_h = h if h > 0 else [120, day_h * days|length]|max %}
<rect width="100%" height="100%" fill="#ffffff"/>
{% if not has_entity %}<text x="12" y="30" font-family="Roboto" font-size="22" fill="#000000">{{ empty_text }}</text>{% elif not days %}<text x="12" y="30" font-family="Roboto" font-size="22" fill="#000000">Kein Unterricht</text>{% else %}
{% for day in days %}{% set y0 = loop.index0 * day_h %}<rect x="0" y="{{ y0 }}" width="{{ w }}" height="{{ header_h }}" fill="#eeeeee"/><text x="12" y="28" font-family="Roboto" font-size="22" font-weight="700" fill="#000000">{{ day.name }} {{ day.date }}</text>{% if day.week %}<text x="{{ w - 90 }}" y="28" font-family="Roboto" font-size="18" font-weight="700" fill="#666666">Woche {{ day.week }}</text>{% endif %}
{% for lesson in day.lessons %}{% set ly = y0 + header_h + loop.index0 * row_h %}<line x1="0" y1="{{ ly + row_h }}" x2="{{ w }}" y2="{{ ly + row_h }}" stroke="#cccccc" stroke-width="1"/><text x="10" y="{{ ly + 21 }}" font-family="Roboto" font-size="17" fill="#666666">{{ lesson.start }}–{{ lesson.end }}</text><text x="115" y="{{ ly + 21 }}" font-family="Roboto" font-size="20" font-weight="700" fill="#000000">{{ lesson.subject }}</text>{% if lesson.badge %}<rect x="{{ w - 150 }}" y="{{ ly + 7 }}" width="140" height="28" rx="8" fill="#000000"/><text x="{{ w - 80 }}" y="{{ ly + 26 }}" text-anchor="middle" font-family="Roboto" font-size="14" font-weight="700" fill="#ffffff">{{ lesson.badge }}</text>{% endif %}<text x="{{ w - 165 if lesson.badge else w - 12 }}" y="{{ ly + 21 }}" text-anchor="end" font-family="Roboto" font-size="17" fill="#666666">{{ lesson.teacher }}{% if lesson.room %} · {{ lesson.room }}{% endif %}</text>{% if lesson.cancelled %}<line x1="115" y1="{{ ly + 16 }}" x2="{{ w - 170 }}" y2="{{ ly + 16 }}" stroke="#000000" stroke-width="2"/>{% endif %}{% endfor %}{% endfor %}{% endif %}
</svg>
