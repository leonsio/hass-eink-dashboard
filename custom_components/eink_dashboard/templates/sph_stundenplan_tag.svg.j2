{% set day = days[0] if days else none %}{% set row_h = 54 %}{% set header_h = 48 %}{% set auto_h = header_h + ((day.lessons|length) if day else 1) * row_h %}<svg xmlns="http://www.w3.org/2000/svg" width="{{ w }}" height="{{ h if h > 0 else auto_h }}">
<rect width="100%" height="100%" fill="#ffffff"/>
{% if not has_entity %}<text x="12" y="30" font-family="Roboto" font-size="22" fill="#000000">{{ empty_text }}</text>{% elif not day %}<text x="12" y="30" font-family="Roboto" font-size="22" fill="#000000">Heute kein Unterricht</text>{% else %}
<rect x="0" y="0" width="{{ w }}" height="{{ header_h }}" fill="#eeeeee"/><text x="12" y="31" font-family="Roboto" font-size="24" font-weight="700" fill="#000000">{{ day.name }} {{ day.date }}</text>{% if day.week %}<text x="{{ w - 90 }}" y="30" font-family="Roboto" font-size="18" font-weight="700" fill="#666666">Woche {{ day.week }}</text>{% endif %}
{% for lesson in day.lessons %}{% set ly = header_h + loop.index0 * row_h %}<line x1="0" y1="{{ ly + row_h }}" x2="{{ w }}" y2="{{ ly + row_h }}" stroke="#cccccc" stroke-width="1"/><text x="10" y="{{ ly + 22 }}" font-family="Roboto" font-size="17" fill="#666666">{{ lesson.start }}–{{ lesson.end }}</text><text x="115" y="{{ ly + 22 }}" font-family="Roboto" font-size="21" font-weight="700" fill="#000000">{{ lesson.subject }}</text>{% if lesson.badge %}<rect x="{{ w - 150 }}" y="{{ ly + 8 }}" width="140" height="28" rx="8" fill="#000000"/><text x="{{ w - 80 }}" y="{{ ly + 27 }}" text-anchor="middle" font-family="Roboto" font-size="14" font-weight="700" fill="#ffffff">{{ lesson.badge }}</text>{% endif %}<text x="{{ w - 165 if lesson.badge else w - 12 }}" y="{{ ly + 22 }}" text-anchor="end" font-family="Roboto" font-size="17" fill="#666666">{{ lesson.teacher }}{% if lesson.room %} · {{ lesson.room }}{% endif %}</text>{% if lesson.cancelled %}<line x1="115" y1="{{ ly + 17 }}" x2="{{ w - 170 }}" y2="{{ ly + 17 }}" stroke="#000000" stroke-width="2"/>{% endif %}{% endfor %}{% endif %}
</svg>
